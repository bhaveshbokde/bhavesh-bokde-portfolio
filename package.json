{
  "name": "bhavesh-bokde-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Cinematic developer portfolio for Bhavesh Bokde, Java Backend Engineer.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
