# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build
/dist

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# environment & secrets — never commit these
#
# `.env*` is the broad form the Vercel CLI appends on `vercel link` / `vercel
# env pull`; it is kept here so the CLI finds what it expects and does not add
# a duplicate at the end of the file. The negation MUST stay after it: git
# applies the last matching pattern, so a later `.env*` would otherwise
# silently re-ignore the example file.
.env
.env.*
.env*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.npmrc

# private / personal material that must not reach a public repository
/private-notes/
/private/
*.private.*

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# editors & os
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# misc
.vercel
*.tsbuildinfo

# visual-check output from scripts/screenshots.mjs
/screenshots/
